# Copy to .env and adjust. Never commit the real .env.
# All values below are safe placeholders for local development.

# --- Application ---------------------------------------------------------
APP_ENV=development
APP_NAME=quali-fly-api
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# --- PostgreSQL ----------------------------------------------------------
# POSTGRES_USER is the superuser that owns the schema and runs Alembic.
# APP_DB_ROLE is the unprivileged role the API connects as. It MUST be a
# different role: superusers and table owners always bypass Row Level Security,
# so the tenant-isolation policies would be inert. Created on first boot by
# infra/postgres/init/10-app-role.sql.
POSTGRES_DB=quali_fly
POSTGRES_USER=quali_fly
POSTGRES_PASSWORD=change-me-locally
APP_DB_ROLE=quali_fly_app
APP_DB_PASSWORD=change-me-locally

# --- Backend -------------------------------------------------------------
# Docker Compose derives both URLs from the variables above. Set them yourself
# when running the backend directly on the host:
#   DATABASE_URL=postgresql+asyncpg://quali_fly_app:<pw>@127.0.0.1:5432/quali_fly
#   MIGRATION_DATABASE_URL=postgresql+asyncpg://quali_fly:<pw>@127.0.0.1:5432/quali_fly
# DATABASE_URL is required. MIGRATION_DATABASE_URL is optional; without it
# Alembic warns and migrates as the application role, which disables RLS.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
API_PREFIX=/api/v1
SESSION_TTL_SECONDS=604800

# --- Meta integration ----------------------------------------------------
# Platform-level Meta app secret. Meta signs each webhook with HMAC-SHA256 over the
# raw body using this value, so it is the boundary between "genuinely delivered by
# our Meta app" and everything else. Also used server-to-server for the
# authorization-code exchange. Never logged, never returned by the API.
# Empty in local development: webhook delivery then fails closed with 403.
META_APP_SECRET=

# Meta app id. Required for OAuth only - webhook delivery does not use it.
META_APP_ID=

# Graph API version for every outbound call. Verified against Meta's changelog on
# 2026-09-28: v26.0 was released 2026-07-29 and is current. Each version is
# supported at least two years, so bump this deliberately and re-run the tests.
META_GRAPH_API_VERSION=v26.0

# Absolute URL Meta redirects to after the authorization dialog. Must match a
# Valid OAuth Redirect URI in the Meta app dashboard byte for byte, or Meta
# rejects the token exchange. Typically
# https://<your-host>/api/v1/meta/oauth/callback
META_OAUTH_REDIRECT_URI=

# Encrypts Meta access tokens at rest (AES-256-GCM). base64url of 32 bytes.
# Generate one with:
#   python -c "from app.core.crypto import generate_key; print(generate_key())"
# REQUIRED in production: the app refuses to boot without it, so a token can never
# be stored in plaintext. Rotating it invalidates every stored token - tenants must
# reconnect their Meta page.
META_TOKEN_ENCRYPTION_KEY=

# Scopes requested at authorization time. These are the permissions Meta's Lead Ads
# documentation requires for webhook subscription plus lead retrieval:
#   leads_retrieval, pages_manage_metadata, pages_show_list,
#   pages_read_engagement, ads_management
# Your app must have these approved in App Review before production use.
META_OAUTH_SCOPES=leads_retrieval,pages_manage_metadata,pages_show_list,pages_read_engagement,ads_management

# How long an OAuth state stays valid, and the per-request Graph timeout.
META_OAUTH_STATE_TTL_SECONDS=600
META_GRAPH_TIMEOUT_SECONDS=10

# --- AI qualification (Phase 5) ------------------------------------------
# Master switch. When false, inbound messages are still stored by Phase 4 and no AI
# call is made at all - the product degrades to "capture without replying" rather than
# failing. When true, GROQ_API_KEY is required or the app refuses to boot, so a
# missing credential is a startup error instead of a per-message provider error.
AI_ENABLED=false

# Provider credentials. Never logged, never returned by the API, never sent to a
# browser. A provider without a key is dropped from the escalation ladder rather
# than being called and failing, so disabling the fallback is a config change.
#   Groq:  https://console.groq.com/keys
#   Gemini: https://aistudio.google.com/apikey
GROQ_API_KEY=
GEMINI_API_KEY=

# Turn the Gemini fallback off entirely. Useful when you only want one vendor
# to be reachable from your network, or to make a Groq outage visible instead of
# silently absorbed.
GEMINI_ENABLED=true

# Which provider leads the ladder, and which one is tried after it. Retry,
# model escalation and vendor fallback are the same mechanism, so changing
# behaviour here needs no code change. Valid: groq, gemini.
AI_PRIMARY_PROVIDER=groq
AI_FALLBACK_PROVIDER=gemini

# Model identifiers are configuration, not business logic. Both Groq models were
# verified against Groq's model list on 2026-09-28. Note that Groq's strict
# json_schema mode is currently limited to the GPT-OSS and Qwen families, so on
# these Llama models the guarantee comes from the request schema plus server-side
# validation, not from the provider constraining its output.
GROQ_PRIMARY_MODEL=llama-3.1-8b-instant
GROQ_ESCALATION_MODEL=llama-3.3-70b-versatile
GEMINI_MODEL=gemini-2.5-flash

# Sampling. Groq uses the PRD's 0.3. Gemini has its own value because Google's
# current guidance for the 3.x family warns that values below 1.0 can cause
# repetition and looping; that is an API requirement, not a preference.
AI_TEMPERATURE=0.3
AI_GEMINI_TEMPERATURE=1.0
AI_MAX_OUTPUT_TOKENS=150

# Per-request provider timeout, and the cap on how many (provider, model) steps
# the ladder may take. The backoff between steps never exceeds
# AI_MAX_BACKOFF_SECONDS, so one inbound message cannot turn into an unbounded
# wait, and no backoff ever happens inside a database transaction.
AI_REQUEST_TIMEOUT_SECONDS=20
AI_MAX_PROVIDER_ATTEMPTS=3
AI_MAX_BACKOFF_SECONDS=2

# Prompt bounds. History is the newest N turns; the current message always
# survives, and history is the first thing dropped if the prompt gets too large.
AI_HISTORY_LIMIT=10
AI_MAX_RESPONSE_CHARS=1000
AI_MAX_PROMPT_CHARS=12000

# A qualification total strictly above this is high intent and marks the lead
# for a human handoff. 0-100, since the four dimensions are 0-25 each. The model
# can also request a handoff on its own at any score.
AI_HANDOFF_SCORE_THRESHOLD=75

# --- Knowledge base / RAG (Phase 6) ---------------------------------------
# Master switch. When false, retrieval returns nothing and the AI falls back to
# its no-knowledge path, so RAG can be disabled without touching the AI pipeline.
EMBEDDING_ENABLED=false

# Provider and model are recorded on every result for audit. The DIMENSION is
# not a knob: it is checked *against* the provider at startup, and the app refuses
# to boot on a mismatch. Set it to 384 to match `hashing`; anything else is a
# configuration error rather than a way to reshape the vector column.
#
# Changing the embedding model later is NOT a config flip. It requires re-embedding
# every stored chunk, and a new migration if the dimension changes - see the README.
EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL=hashed-ngram-384
EMBEDDING_DIMENSION=384
EMBEDDING_TIMEOUT=30

# Chunking, in characters. 1200 with 200 overlap keeps a typical FAQ answer whole
# while still splitting long documents, and the overlap stops a boundary from
# severing a sentence. Deterministic: same text + same config = same chunks.
KNOWLEDGE_CHUNK_SIZE=1200
KNOWLEDGE_CHUNK_OVERLAP=200
# Ceiling on chunks per document, so one paste cannot start an unbounded number
# of embedding calls. Must be greater than zero.
KNOWLEDGE_MAX_CHUNKS_PER_DOCUMENT=500

# Top-5 is a Phase 6 contract rather than a preference, so it is capped at 5:
# a larger K would push context selection into the AI layer, which is the
# boundary this phase exists to hold.
RAG_TOP_K=5
# Cosine similarity floor. Conservative on purpose - a weakly-matching chunk is
# worse than none, because the model may treat it as fact and state it to a lead.
# Set to 0 to take the top K regardless of score.
RAG_MIN_SIMILARITY=0.15
# Ceiling on rendered knowledge context, so a tenant with many large chunks
# cannot crowd out the conversation itself.
RAG_MAX_CONTEXT_CHARS=4000

# --- Automated follow-up engine (Phase 7) --------------------------------
# Master switch. When false the poller is not started at all - not started and
# finding nothing - and Phase 5 answers inbound messages exactly as before.
# The durable record of what is owed is the `scheduled_tasks` table, not this
# poller, so replacing the container loses nothing.
FOLLOW_UP_ENABLED=false

# How often the poller wakes up. It is a trigger only; PostgreSQL is the state.
FOLLOW_UP_POLL_INTERVAL_SECONDS=30
# Tasks claimed per poll per tenant, so one busy tenant cannot monopolise a worker.
FOLLOW_UP_BATCH_SIZE=20
# How long a claimed task may sit in PROCESSING before another worker may
# reclaim it. Must comfortably exceed the slowest plausible execute (AI call +
# Meta send), or two workers will race on one task. This is the mechanism that
# recovers a task whose worker died mid-send.
FOLLOW_UP_PROCESSING_LEASE_SECONDS=300
# Bounded on both sides: a courtesy message retried ten times is not a courtesy.
FOLLOW_UP_MAX_ATTEMPTS=3
# Base for the exponential backoff between retries, in seconds.
FOLLOW_UP_RETRY_BASE_SECONDS=60
# The PRD's 7-day inactivity boundary at which a silent lead becomes GHOSTED.
FOLLOW_UP_GHOSTED_DAYS=7
# Whether the AI may improve a tenant's template wording. When false, or when no
# provider is configured, the deterministic template is sent as-is.
FOLLOW_UP_AI_ENHANCE=true

# --- Human handoff (Phase 8) ----------------------------------------------
# Master switch. When false, Phase 5 still records the escalation exactly as
# before, but no handoff row, notification or acknowledgement is created and
# the conversation stays with the AI. This is a rollback lever, not a quiet
# degradation - flipping it hands conversations back to automation, which
# should be somebody's explicit decision.
HANDOFF_ENABLED=true
# The message sent when a lead is escalated and the AI's own reply did not
# reach them. No placeholders on purpose: this is the one message a lead may
# see after the product has already failed them once, so it must not be able to
# render a name we do not have. Keep it true - promising a callback we may not
# make is worse than the silence.
HANDOFF_ACKNOWLEDGEMENT_TEXT=Thanks for your patience - I've passed this to our team and someone will be in touch shortly.
# How much of the lead's last message is kept on the handoff row as the queue
# preview. A triage line, not a transcript; the full thread is always one click
# away. 40-2000.
HANDOFF_PREVIEW_CHARS=280

# --- Frontend (public values only) ---------------------------------------
# Inlined into the browser bundle at build time. Leave the API base URL empty
# in Docker so the browser calls Nginx on the same origin.
NEXT_PUBLIC_API_BASE_URL=

# --- Nginx ---------------------------------------------------------------
HTTP_PORT=8080
